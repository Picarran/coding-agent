# Copy this file to `.env` and fill in your DeepSeek API key.
# `.env` is gitignored and must never be committed.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_FAST_MODEL=

# GitHub MCP server auth (optional; needed by mcp__github__* tools).
# Create a fine-grained PAT with Contents read/write + Administration read/write
# (or a classic token with `repo` scope) at github.com/settings/tokens.
GITHUB_PERSONAL_ACCESS_TOKEN=

# Cost model for the performance dashboard (USD per 1M tokens).
# Defaults are deepseek-chat list prices; override if your model/pricing differs.
DEEPSEEK_INPUT_PRICE=0.27
DEEPSEEK_OUTPUT_PRICE=1.10
